# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ── Storage ──────────────────────────────────────────────────
PROJECTS_ROOT=
MODELS_CACHE_DIR=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./sonicforge.db

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI Providers ─────────────────────────────────────────────
HUGGINGFACE_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
