# .gitignore — SonicForge

# ── Environment ───────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Node / pnpm ───────────────────────────────────────────────
node_modules/
dist/
.pnpm-store/
.pnpm-debug.log

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.uv/

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Database ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
celery*.log

# ── AI Model Weights ──────────────────────────────────────────
# Models are cached in ~/.sonicforge/models — not stored in repo
*.bin
*.safetensors
*.gguf
*.onnx
models/

# ── Audio assets (user-generated, not part of source) ─────────
apps/api/sonicforge/projects/
sonicforge-projects/

# ── Build outputs ─────────────────────────────────────────────
apps/web/dist/
apps/api/dist/

# ── Testing ───────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Docker ────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore local overrides
docker-compose.override.yml
